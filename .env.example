# PostgreSQL (DigitalOcean Managed Database)
DATABASE_URL=postgresql://user:password@host:25060/scraper?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION=7d

# Encryption key for stored credentials (profile passwords, PINs, etc.)
ENCRYPTION_KEY=replace-with-32-byte-hex-string

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Gmail OTP reader
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# App
NODE_ENV=development
PORT=4000
HEADLESS=true
BROWSER_CHANNEL=chrome
TZ=Asia/Bangkok
